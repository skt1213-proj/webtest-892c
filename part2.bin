',name:'駅',short:'駅',canvasW:540,canvasH:960,flowW:120,flowH:213,flowGC:12,flowGR:20,warpRX:16,warpRY:28,landscape:false},
  akasaka:{tw:360,th:640,cols:11,rows:3,qw:3960,qh:1920,src:'data:image/jpeg;base64,',name:'赤坂通り',short:'赤坂通り',canvasW:540,canvasH:960,flowW:120,flowH:213,flowGC:12,flowGR:20,warpRX:16,warpRY:28,landscape:false},
  sawadee_wide:{tw:640,th:360,cols:11,rows:3,qw:7040,qh:1080,src:'data:image/jpeg;base64,',name:'サワディー（横）',short:'サワディー（横）',canvasW:960,canvasH:540,flowW:213,flowH:120,flowGC:20,flowGR:12,warpRX:28,warpRY:16,landscape:true},
  sawadee_portrait:{tw:360,th:640,cols:11,rows:3,qw:3960,qh:1920,src:'data:image/jpeg;base64,',name:'サワディー（縦）',short:'サワディー（縦）',canvasW:540,canvasH:960,flowW:120,flowH:213,flowGC:12,flowGR:20,warpRX:16,warpRY:28,landscape:false}
};
var MEAS_SRC={}, MEAS_NAME={}, measData={};
Object.keys(MEAS_META).forEach(function(k){ MEAS_SRC[k]=MEAS_META[k].src; MEAS_NAME[k]=MEAS_META[k].name; measData[k]={img:null,pixels:null,gray:null,flows:{},flowPending:{},prefetchStarted:false}; });
var stationCanvas=document.getElementById('stationCanvas');
var station2d=stationCanvas.getContext('2d');
function isMeas(s){ return !!MEAS_META[s]; }
function measMeta(key){ return MEAS_META[key||state.scene]||MEAS_META.station; }
function curMeas(){ return measData[state.scene]||measData.station; }
function loadMeasData(key){
  var meta=MEAS_META[key];
  var img=new Image();
  img.onload=function(){
    measData[key].img=img;
    var pc=document.createElement('canvas'); pc.width=meta.qw; pc.height=meta.qh;
    var pctx=pc.getContext('2d'); pctx.drawImage(img,0,0);
    try{ measData[key].pixels=pctx.getImageData(0,0,meta.qw,meta.qh).data; }catch(e){ measData[key].pixels=null; }
    buildMeasGray(key);
    if(state.scene===key){ drawMain(); renderInspector(); }
  };
  img.src=MEAS_SRC[key];
}
// ---------- Motion-compensated interpolation between measured frames ----------
// Plain crossfade stacks two frames that are already a few px apart, so every
// edge doubles and the view still steps. Instead, the flow between each pair
// of neighbouring frames is estimated per region (block matching on a small
// grayscale copy, computed on-device, cached per pair): foreground regions
// move more, background less. An in-between viewpoint is then synthesized by
// shifting the earlier frame forward by f*flow and the later frame back by
// (1-f)*flow before blending — the two copies land on top of each other at
// the intermediate position, so structures travel instead of ghosting.
// Flow geometry is per scene (MEAS_META): the small grayscale copy and the
// block grid follow the tile aspect — portrait scenes use 120x213 / 12x20,
// the landscape Sawadee scene uses 213x120 / 20x12.
function buildMeasGray(key){
  var meta=MEAS_META[key], FLOW_W=meta.flowW, FLOW_H=meta.flowH;
  var M=measData[key]; if(!M.img||M.gray) return;
  var c=document.createElement('canvas'); c.width=FLOW_W; c.height=FLOW_H;
  var x=c.getContext('2d'); var grays=[];
  for(var v=0;v<33;v++){
    x.drawImage(M.img,(v%meta.cols)*meta.tw,Math.floor(v/meta.cols)*meta.th,meta.tw,meta.th,0,0,FLOW_W,FLOW_H);
    var d=null; try{ d=x.getImageData(0,0,FLOW_W,FLOW_H).data; }catch(e){ return; }
    var g=new Uint8Array(FLOW_W*FLOW_H);
    for(var i=0,j=0;i<g.length;i++,j+=4){ g[i]=(d[j]*77+d[j+1]*150+d[j+2]*29)>>8; }
    grays.push(g);
  }
  M.gray=grays;
  scheduleFlowPrefetch(key);
}
function computeFlow(key,v){
  var meta=MEAS_META[key], FLOW_W=meta.flowW, FLOW_H=meta.flowH, FLOW_GC=meta.flowGC, FLOW_GR=meta.flowGR;
  var M=measData[key]; if(!M.gray) return null;
  if(M.flows[v]) return M.flows[v];
  var a=M.gray[v], b=M.gray[v+1]; if(!a||!b) return null;
  var raw=new Float32Array(FLOW_GC*FLOW_GR*2);
  for(var gy=0;gy<FLOW_GR;gy++) for(var gx=0;gx<FLOW_GC;gx++){
    var cx=Math.round((gx+0.5)*FLOW_W/FLOW_GC), cy=Math.round((gy+0.5)*FLOW_H/FLOW_GR);
    var best=Infinity, bdx=0, bdy=0;
    for(var dy=-3;dy<=3;dy++) for(var dx=-7;dx<=7;dx++){
      var sad=0, cnt=0;
      for(var py=-5;py<=5;py+=2) for(var px=-5;px<=5;px+=2){
        var ax=cx+px, ay=cy+py, bx=ax+dx, by=ay+dy;
        if(ax<0||ay<0||ax>=FLOW_W||ay>=FLOW_H||bx<0||by<0||bx>=FLOW_W||by>=FLOW_H) continue;
        var dd=a[ay*FLOW_W+ax]-b[by*FLOW_W+bx]; sad+=dd<0?-dd:dd; cnt++;
      }
      if(cnt){ sad/=cnt; if(sad<best){ best=sad; bdx=dx; bdy=dy; } }
    }
    var idx=(gy*FLOW_GC+gx)*2;
    raw[idx]=bdx*(meta.tw/FLOW_W); raw[idx+1]=bdy*(meta.th/FLOW_H);
  }
  // Smooth the field and replace outliers (independently moving people,
  // textureless patches) with their neighbourhood average.
  var flow=new Float32Array(raw.length);
  for(var gy2=0;gy2<FLOW_GR;gy2++) for(var gx2=0;gx2<FLOW_GC;gx2++){
    var sx=0, sy=0, n=0;
    for(var oy=-1;oy<=1;oy++) for(var ox=-1;ox<=1;ox++){
      var nx=gx2+ox, ny=gy2+oy; if(nx<0||ny<0||nx>=FLOW_GC||ny>=FLOW_GR) continue;
      var ii=(ny*FLOW_GC+nx)*2; sx+=raw[ii]; sy+=raw[ii+1]; n++;
    }
    var axx=sx/n, ayy=sy/n, ci=(gy2*FLOW_GC+gx2)*2;
    if(Math.abs(raw[ci]-axx)>5||Math.abs(raw[ci+1]-ayy)>5){ flow[ci]=axx; flow[ci+1]=ayy; }
    else { flow[ci]=raw[ci]*0.55+axx*0.45; flow[ci+1]=raw[ci+1]*0.55+ayy*0.45; }
  }
  M.flows[v]=flow;
  updateInterpStatus();
  return flow;
}
function getFlow(key,v){
  var M=measData[key];
  if(M.flows[v]) return M.flows[v];
  if(!M.flowPending[v]){
    M.flowPending[v]=true;
    setTimeout(function(){ M.flowPending[v]=false; computeFlow(key,v); if(state.scene===key) drawMain(); },0);
  }
  return null;
}
function scheduleFlowPrefetch(key){
  var M=measData[key]; if(M.prefetchStarted||!M.gray) return;
  M.prefetchStarted=true;
  // Pairs nearest the center view first, then outward — the user starts at
  // frame 17 and explores from there.
  var order=[], d, v;
  for(d=0;d<32;d++){ v=16-d; if(v>=0&&order.indexOf(v)<0) order.push(v); v=16+d; if(v<32&&order.indexOf(v)<0) order.push(v); }
  var i=0;
  (function step(){
    if(i>=order.length){ updateInterpStatus(); return; }
    computeFlow(key, order[i++]);
    setTimeout(step, 30);
  })();
}
function updateInterpStatus(){
  var el=document.getElementById('interpStatus'); if(!el) return;
  if(!isMeas(state.scene)){ el.textContent=''; return; }
  var M=curMeas(), n=0;
  if(M.flows){ for(var k in M.flows) n++; }
  el.textContent = n>=32 ? '動きデータ準備完了（32組すべて補間可能）' : ('動きデータ準備中… '+n+' / 32組（できた範囲から補間します）');
}
function sampleFlow(flow,u,vv,out){
  var FLOW_GC=measMeta().flowGC, FLOW_GR=measMeta().flowGR;
  var gx=Math.max(0,Math.min(FLOW_GC-1.001, u*FLOW_GC-0.5));
  var gy=Math.max(0,Math.min(FLOW_GR-1.001, vv*FLOW_GR-0.5));
  var x0=Math.floor(gx), y0=Math.floor(gy), wx=gx-x0, wy=gy-y0;
  var x1=Math.min(FLOW_GC-1,x0+1), y1=Math.min(FLOW_GR-1,y0+1);
  function F(xx,yy,c){ return flow[(yy*FLOW_GC+xx)*2+c]; }
  out[0]=(F(x0,y0,0)*(1-wx)+F(x1,y0,0)*wx)*(1-wy)+(F(x0,y1,0)*(1-wx)+F(x1,y1,0)*wx)*wy;
  out[1]=(F(x0,y0,1)*(1-wx)+F(x1,y0,1)*wx)*(1-wy)+(F(x0,y1,1)*(1-wx)+F(x1,y1,1)*wx)*wy;
}
var warpPt=[0,0];
// Draw one warped block, clipping the source rect to the tile's own bounds
// (and shifting/shrinking the destination to match) — a block at the frame
// edge must never sample the neighbouring tile of the quilt.
function drawWarpBlock(img,ox,oy,sx,sy,sw,sh,dx,dy,dw,dh){
  var meta=measMeta(), kx=dw/sw, ky=dh/sh;
  if(sx<0){ dx+=-sx*kx; dw-=-sx*kx; sw+=sx; sx=0; }
  if(sy<0){ dy+=-sy*ky; dh-=-sy*ky; sh+=sy; sy=0; }
  if(sx+sw>meta.tw){ var ex=sx+sw-meta.tw; dw-=ex*kx; sw-=ex; }
  if(sy+sh>meta.th){ var ey=sy+sh-meta.th; dh-=ey*ky; sh-=ey; }
  if(sw<=0.5||sh<=0.5||dw<=0.5||dh<=0.5) return;
  station2d.drawImage(img, ox+sx, oy+sy, sw, sh, dx, dy, dw, dh);
}
function drawStationWarp(i0,i1,f,flow){
  var meta=measMeta();
  var img=curMeas().img, W=stationCanvas.width, H=stationCanvas.height;
  var RX=meta.warpRX, RY=meta.warpRY, bw=W/RX, bh=H/RY, sw=meta.tw/RX, sh=meta.th/RY;
  var ox0=(i0%meta.cols)*meta.tw, oy0=Math.floor(i0/meta.cols)*meta.th;
  var ox1=(i1%meta.cols)*meta.tw, oy1=Math.floor(i1/meta.cols)*meta.th;
  // Base: earlier frame as-is — warped blocks are drawn over it, so tile
  // edges and any source-clipped strips never show through as blanks.
  drawStationTile(i0,1);
  // Earlier frame, forward-warped by f*flow (blocks slightly overlapped:
  // opaque overdrawing of near-identical content hides seams).
  var exD=1.5, eyD=1.5, exS=exD*meta.tw/W, eyS=eyD*meta.th/H;
  for(var by=0;by<RY;by++) for(var bx=0;bx<RX;bx++){
    sampleFlow(flow,(bx+0.5)/RX,(by+0.5)/RY,warpPt);
    var sx=bx*sw - f*warpPt[0], sy=by*sh - f*warpPt[1];
    drawWarpBlock(img, ox0, oy0, sx-exS, sy-eyS, sw+2*exS, sh+2*eyS, bx*bw-exD, by*bh-eyD, bw+2*exD, bh+2*eyD);
  }
  // Later frame, backward-warped by (1-f)*flow, blended with weight f.
  // Exact tiling here (no overlap) so the alpha never double-blends.
  station2d.globalAlpha=f;
  for(var by2=0;by2<RY;by2++) for(var bx2=0;bx2<RX;bx2++){
    sampleFlow(flow,(bx2+0.5)/RX,(by2+0.5)/RY,warpPt);
    var sx2=bx2*sw + (1-f)*warpPt[0], sy2=by2*sh + (1-f)*warpPt[1];
    drawWarpBlock(img, ox1, oy1, sx2, sy2, sw, sh, bx2*bw, by2*bh, bw, bh);
  }
  station2d.globalAlpha=1;
}
function stationPos(){ return Math.max(0,Math.min(32,(state.ex+30)/60*32)); }
function drawStationTile(v, alpha){
  var meta=measMeta();
  station2d.globalAlpha=alpha;
  station2d.drawImage(curMeas().img, (v%meta.cols)*meta.tw, Math.floor(v/meta.cols)*meta.th, meta.tw, meta.th, 0, 0, stationCanvas.width, stationCanvas.height);
  station2d.globalAlpha=1;
}
function drawStation(){
  if(!curMeas().img){
    station2d.fillStyle='#0c0d0e'; station2d.fillRect(0,0,stationCanvas.width,stationCanvas.height);
    station2d.fillStyle='#f2efe6'; station2d.font='20px sans-serif';
    station2d.fillText('実写データを読み込み中…', 40, 80);
    return;
  }
  if(state.scene==='sawadee_portrait'&&Math.abs(state.z)>0.003&&depthData[state.depthSrc].pixels){ drawStationZ(); return; }
  var pos=stationPos(), q=quantValue();
  if(q>0){
    // nearest modes: subsets of the same 33 measured views —
    // 17 views = every 2nd, 9 = every 4th, 5 = every 8th.
    var step=32/(q-1);
    drawStationTile(Math.round(Math.round(pos/step)*step), 1);
    return;
  }
  var i0=Math.floor(pos), i1=Math.min(32,i0+1), f=pos-i0;
  if(f<0.001||i1===i0){ drawStationTile(i0,1); return; }
  if(state.interp==='none'){ drawStationTile(Math.round(pos),1); return; }
  if(state.interp==='warp'){
    var flow=getFlow(state.scene,i0);
    if(flow){ drawStationWarp(i0,i1,f,flow); return; }
    // Flow for this pair is still being estimated: fall through to the
    // crossfade for this frame only — the warp takes over as soon as the
    // pair is ready (getFlow schedules a redraw).
  }
  drawStationTile(i0, 1);
  drawStationTile(i1, f);
}

// ---------- PART4: distance (z) for sawadee_portrait only ----------
// Depth quilts share the color quilt layout (11x3, tile 360x640), grayscale
// disparity, bright = near. Two switchable sources:
//   est: Depth Anything V2 per frame, globally normalized over all 33 frames.
//   sfm: COLMAP SfM on 81 frames (all registered, 10,003 points); sparse
//        points projected into each of the 33 frames, hole-filled by diffusion.
// Pivot = the subject's typical disparity per source, so z=0 is identity and
// the person (near the pivot) stays put while the background scales around
// the anchor point — dolly parallax, combined with the theta frame blend.
var DEPTH_CONF={
  est:{src:'data:image/jpeg;base64,', pivot:0.46, gain:0.60},
  sfm:{src:'data:image/jpeg;base64,', pivot:0.63, gain:0.55}
};
var depthData={est:{img:null,pixels:null}, sfm:{img:null,pixels:null}};
function loadDepthData(key){
  var img=new Image();
  img.onload=function(){
    depthData[key].img=img;
    var pc=document.createElement('canvas'); pc.width=3960; pc.height=1920;
    var pctx=pc.getContext('2d'); pctx.drawImage(img,0,0);
    try{ depthData[key].pixels=pctx.getImageData(0,0,3960,1920).data; }catch(e){ depthData[key].pixels=null; }
    if(state.scene==='sawadee_portrait') drawMain();
  };
  img.src=DEPTH_CONF[key].src;
}
function depthAt(key, v, tx, ty){
  var P=depthData[key].pixels; if(!P) return DEPTH_CONF[key].pivot;
  var meta=MEAS_META.sawadee_portrait;
  var x=(v%meta.cols)*meta.tw+Math.max(0,Math.min(meta.tw-1,tx)), y=Math.floor(v/meta.cols)*meta.th+Math.max(0,Math.min(meta.th-1,ty));
  return P[(y*3960+x)*4]/255;
}
// Draw one frame warped by z: the frame is split into blocks; each block is
// scaled about the subject anchor by 1 + z*(disparity - pivot)*gain. Blocks
// at the pivot disparity do not move (the person stays stable); farther
// blocks move more. Slight block overlap hides seams, as in the flow warp.
function drawStationZFrame(v, alpha){
  var meta=measMeta(), conf=DEPTH_CONF[state.depthSrc];
  var img=curMeas().img, W=stationCanvas.width, H=stationCanvas.height;
  var RX=18, RY=32, bw=W/RX, bh=H/RY, sw=meta.tw/RX, sh=meta.th/RY;
  var ox=(v%meta.cols)*meta.tw, oy=Math.floor(v/meta.cols)*meta.th;
  var ax=W*0.5, ay=H*0.42; // subject anchor (his position in frame)
  station2d.globalAlpha=alpha;
  for(var by=0;by<RY;by++) for(var bx=0;bx<RX;bx++){
    var cx=bx*bw+bw/2, cy=by*bh+bh/2;
    var disp=depthAt(state.depthSrc, v, Math.round((bx+0.5)*sw), Math.round((by+0.5)*sh));
    var s=1+state.z*(disp-conf.pivot)*conf.gain;
    if(s<0.55)s=0.55; if(s>1.6)s=1.6;
    var dw=bw*s+2.5, dh=bh*s+2.5;
    var dx=ax+(cx-ax)*s-dw/2, dy=ay+(cy-ay)*s-dh/2;
    station2d.drawImage(img, ox+bx*sw, oy+by*sh, sw, sh, dx, dy, dw, dh);
  }
  station2d.globalAlpha=1;
}
function drawStationZ(){
  var pos=stationPos(), q=quantValue();
  if(q>0){ var step=32/(q-1); drawStationZFrame(Math.round(Math.round(pos/step)*step),1); return; }
  var i0=Math.floor(pos), i1=Math.min(32,i0+1), f=pos-i0;
  if(f<0.001||i1===i0||state.interp==='none'){ drawStationZFrame(Math.round(pos),1); return; }
  // With z active the two theta neighbours are z-warped then crossfaded
  // (the flow warp and the z warp are not composed in this version).
  drawStationZFrame(i0,1);
  if(f>0) drawStationZFrame(i1,f);
}

function quantValue(){ return state.mode==='cont'?0:parseInt(state.mode,10); }
function drawMain(){
  if(isMeas(state.scene)){ drawStation(); return; }
  if(!mainGL) return;
  if(state.scene==='photo'){ drawPhoto(); return; }
  var gl=mainGL.gl, c=gl.canvas;
  gl.useProgram(mainGL.prog);
  gl.bindBuffer(gl.ARRAY_BUFFER, mainGL.buf);
  gl.enableVertexAttribArray(mainGL.aPos); gl.vertexAttribPointer(mainGL.aPos,2,gl.FLOAT,false,0,0);
  gl.viewport(0,0,c.width,c.height);
  gl.uniform2f(mainGL.uEye, state.ex/30, -state.ey/20*0.72);
  gl.uniform1f(mainGL.uQuant, quantValue());
  gl.uniform1f(mainGL.uAspect, c.width/c.height);
  gl.drawArrays(gl.TRIANGLE_STRIP,0,4);
}
function drawQuilt(){
  if(!quiltGL) return;
  var gl=quiltGL.gl, c=gl.canvas, N=9, tw=c.width/N, th=c.height/N;
  gl.useProgram(quiltGL.prog);
  gl.bindBuffer(gl.ARRAY_BUFFER, quiltGL.buf);
  gl.enableVertexAttribArray(quiltGL.aPos); gl.vertexAttribPointer(quiltGL.aPos,2,gl.FLOAT,false,0,0);
  gl.clearColor(0.05,0.05,0.05,1); gl.clear(gl.COLOR_BUFFER_BIT);
  gl.enable(gl.SCISSOR_TEST);
  for(var ty=0;ty<N;ty++) for(var tx=0;tx<N;tx++){
    var x=tx*tw, y=ty*th;
    gl.viewport(x,y,tw-2,th-2); gl.scissor(x,y,tw-2,th-2);
    var ex=((tx-(N-1)/2)/((N-1)/2))*30;
    var ey=((ty-(N-1)/2)/((N-1)/2))*20;
    gl.uniform2f(quiltGL.uEye, ex/30, -ey/20*0.72);
    gl.uniform1f(quiltGL.uQuant, 0);
    gl.uniform1f(quiltGL.uAspect, 1.333);
    gl.drawArrays(gl.TRIANGLE_STRIP,0,4);
  }
  gl.disable(gl.SCISSOR_TEST);
}

// ---------- Inspector ----------
function rgbStr(r,g,b){ return 'rgb('+r+','+g+','+b+')'; }
function rgbHex(r,g,b){
  function h(v){ var s=v.toString(16); return s.length<2?'0'+s:s; }
  return ('#'+h(r)+h(g)+h(b)).toUpperCase();
}
function samplePhotoTile(px,py,c,r){
  var x=c*192+px, y=r*144+py, i=(y*3264+x)*4;
  return [photoPixels[i], photoPixels[i+1], photoPixels[i+2]];
}
function sampleStationTile(px,py,v){
  var meta=measMeta(), P=curMeas().pixels;
  var x=(v%meta.cols)*meta.tw+px, y=Math.floor(v/meta.cols)*meta.th+py, i=(y*meta.qw+x)*4;
  return [P[i], P[i+1], P[i+2]];
}
function renderInspectorMeas(){
  var meta=measMeta();
  var grid=document.getElementById('angleGrid'); grid.innerHTML='';
  grid.style.gridTemplateColumns='repeat(33,1fr)'; grid.style.gap='1px';
  var px=Math.round(state.selX/255*(meta.tw-1)), py=Math.round(state.selY/191*(meta.th-1));
  document.getElementById('pixelCoord').textContent='P ('+px+', '+py+') · '+meta.tw+'×'+meta.th;
  if(!curMeas().pixels){
    document.getElementById('pixelSwatch').style.background='#888';
    document.getElementById('pixelHex').textContent='実写データを読み込み中…';
    return;
  }
  var cen=sampleStationTile(px,py,16);
  document.getElementById('pixelSwatch').style.background=rgbStr(cen[0],cen[1],cen[2]);
  document.getElementById('pixelHex').textContent=rgbHex(cen[0],cen[1],cen[2])+' · '+MEAS_NAME[state.scene]+'（実測）中心フレーム';
  for(var v=0;v<33;v++){
    var s=sampleStationTile(px,py,v);
    var el=document.createElement('i');
    el.style.background=rgbStr(s[0],s[1],s[2]);
    el.title='θ '+((v-16)*1.875).toFixed(1)+'° · フレーム '+(v+1)+'/33 → '+rgbHex(s[0],s[1],s[2]);
    if(v===16) el.className='center';
    grid.appendChild(el);
  }
}
function renderInspectorPhoto(){
  var grid=document.getElementById('angleGrid'); grid.innerHTML='';
  grid.style.gridTemplateColumns='repeat(17,1fr)'; grid.style.gap='2px';
  var px=Math.round(state.selX/255*191), py=Math.round(state.selY/191*143);
  document.getElementById('pixelCoord').textContent='P ('+px+', '+py+') · 192×144';
  if(!photoPixels){
    document.getElementById('pixelSwatch').style.background='#888';
    document.getElementById('pixelHex').textContent='写真データを読み込み中…';
    return;
  }
  var cen=samplePhotoTile(px,py,8,8);
  document.getElementById('pixelSwatch').style.background=rgbStr(cen[0],cen[1],cen[2]);
  document.getElementById('pixelHex').textContent=rgbHex(cen[0],cen[1],cen[2])+' · 写真';
  for(var row=0;row<17;row++){
    for(var colI=0;colI<17;colI++){
      var s=samplePhotoTile(px,py,colI,row);
      var el=document.createElement('i');
      el.style.background=rgbStr(s[0],s[1],s[2]);
      el.title='θ '+((colI-8)*3.75)+'° φ '+((8-row)*2.5)+'° → '+rgbHex(s[0],s[1],s[2]);
      if(row===8&&colI===8) el.className='center';
      grid.appendChild(el);
    }
  }
}
function renderInspector(){
  if(isMeas(state.scene)){ renderInspectorMeas(); return; }
  if(state.scene==='photo'){ renderInspectorPhoto(); return; }
  var grid=document.getElementById('angleGrid'); grid.innerHTML='';
  grid.style.gridTemplateColumns='repeat(9,1fr)'; grid.style.gap='3px';
  // plate point from selected pixel: 256x192 space -> world
  var px=((state.selX/255)*2-1)*1.62;
  var py=((1-state.selY/191)*2-1)*1.22;
  var centerRes=traceCPU(px,py,0,0);
  document.getElementById('pixelCoord').textContent='P ('+state.selX+', '+state.selY+')';
  document.getElementById('pixelSwatch').style.background=shadeHex(centerRes.hex,1);
  document.getElementById('pixelHex').textContent=centerRes.hex + (centerRes.isWall?' · 奥の壁':' · ブロック');
  for(var row=0;row<9;row++){
    for(var colI=0;colI<9;colI++){
      var sx=((colI-4)/4)*0.55;
      var sy=((row-4)/4)*0.38; // row 0 = top = +sy? screen top should be up: invert
      sy=-sy;
      var r=traceCPU(px,py,sx,sy);
      var el=document.createElement('i');
      el.style.background=shadeHex(r.hex, r.isWall?1:0.95);
      el.title='θ '+Math.round(Math.atan(sx)*57.3)+'° φ '+Math.round(Math.atan(-sy)*57.3)+'° → '+r.hex;
      if(row===4&&colI===4) el.className='center';
      grid.appendChild(el);
    }
  }
}

// ---------- UI wiring ----------
var sliderX=document.getElementById('sliderX'), sliderY=document.getElementById('sliderY');
var elOutX=document.getElementById('outX'), elOutY=document.getElementById('outY');
var elRoTheta=document.getElementById('roTheta'), elRoPhi=document.getElementById('roPhi'), elRoMode=document.getElementById('roMode');
var presetBtns=Array.prototype.slice.call(document.querySelectorAll('[data-preset]'));
// Light per-frame update: text + sliders only. No querySelectorAll / layout work,
// so the single WebGL draw for the whole plate is never stalled frame-by-frame.
function syncReadout(){
  sliderX.value=state.ex; sliderY.value=state.ey;
  elOutX.textContent=Math.round(state.ex)+'°';
  elOutY.textContent=Math.round(state.ey)+'°';
  elRoTheta.textContent=Number(state.ex).toFixed(1)+'°';
  elRoPhi.textContent=Number(state.ey).toFixed(1)+'°';
}
function syncUI(){
  syncReadout();
  elRoMode.textContent=modeLabel[state.mode];
  presetBtns.forEach(function(b){
    var p=b.getAttribute('data-preset').split(',');
    b.classList.toggle('active', Math.abs(parseFloat(p[0])-state.ex)<0.6 && Math.abs(parseFloat(p[1])-state.ey)<0.6);
  });
}
sliderX.addEventListener('input',function(){ stopTilt(); state.glide=null; state.ex=state.tx=parseFloat(this.value); state.orbit=false; document.getElementById('orbitBtn').classList.remove('active'); syncUI(); drawMain(); });
sliderY.addEventListener('input',function(){ stopTilt(); state.glide=null; state.ey=state.ty=parseFloat(this.value); state.orbit=false; document.getElementById('orbitBtn').classList.remove('active'); syncUI(); drawMain(); });

presetBtns.forEach(function(b){
  b.addEventListener('click',function(){
    var p=this.getAttribute('data-preset').split(',');
    stopTilt();
    state.orbit=false;
    document.getElementById('orbitBtn').classList.remove('active');
    // Glide the ONE shared eye to the preset — whole plate travels together.
    state.glide={fx:state.ex, fy:state.ey, tx:parseFloat(p[0]), ty:parseFloat(p[1]), p:0};
    syncUI();
  });
});
document.getElementById('orbitBtn').addEventListener('click',function(){
  state.orbit=!state.orbit; state.glide=null; this.classList.toggle('active',state.orbit);
  if(state.orbit) stopTilt();
});
document.querySelectorAll('#modeSeg button').forEach(function(b){
  b.addEventListener('click',function(){
    document.querySelectorAll('#modeSeg button').forEach(function(x){x.classList.remove('active')});
    b.classList.add('active'); state.mode=b.getAttribute('data-mode');
    syncUI(); drawMain();
  });
});
// PART4 wiring: dolly slider + depth source toggle (sawadee_portrait only)
var dollySlider=document.getElementById('dollySlider'), elOutZ=document.getElementById('outZ');
dollySlider.addEventListener('input',function(){ state.tz=parseFloat(this.value)/100; elOutZ.textContent=this.value; });
document.querySelectorAll('#depthSeg button').forEach(function(b){
  b.addEventListener('click',function(){
    document.querySelectorAll('#depthSeg button').forEach(function(x){x.classList.remove('active')});
    b.classList.add('active'); state.depthSrc=b.getAttribute('data-depthsrc');
    drawMain();
  });
});
document.querySelectorAll('#interpSeg button').forEach(function(b){
  b.addEventListener('click',function(){
    document.querySelectorAll('#interpSeg button').forEach(function(x){x.classList.remove('active')});
    b.classList.add('active'); state.interp=b.getAttribute('data-interp');
    drawMain();
  });
});

// ---------- Scene switching ----------
var BLOCK_QUILT_CAP=document.getElementById('quiltCap').innerHTML;
var BLOCK_GRID_CAP='この 9×9 が、<strong>1ピクセルが持っているもの</strong>です。板の上でクリック／タップすると、その場所の表に切り替わります。縁のピクセルほど、方向で色が激しく変わります。';
var MODE_NOTE_DEFAULT=document.getElementById('modeNote').innerHTML;
var MODE_BTN_DEFAULT={};
document.querySelectorAll('#modeSeg button').forEach(function(b){ MODE_BTN_DEFAULT[b.getAttribute('data-mode')]=b.textContent; });
function setScene(s){
  state.scene=s;
  var photo=(s==='photo'), station=isMeas(s);
  document.querySelectorAll('#sceneSeg button').forEach(function(b){ b.classList.toggle('active', b.getAttribute('data-scene')===s); });
  var stageEl=document.getElementById('stage');
  stageEl.classList.toggle('station-mode', station);
  stageEl.classList.toggle('meas-landscape', station&&measMeta(s).landscape);
  if(station){
    // Plate canvas follows the scene's tile aspect (portrait 540x960 / landscape 960x540)
    var mm=measMeta(s);
    if(stationCanvas.width!==mm.canvasW||stationCanvas.height!==mm.canvasH){ stationCanvas.width=mm.canvasW; stationCanvas.height=mm.canvasH; }
  }
  document.getElementById('quiltCanvas').style.display=(!photo&&!station)?'block':'none';
  var qImg=document.getElementById('quiltImg');
  qImg.style.display=(photo||station)?'block':'none';
  if(photo){ qImg.src='data:image/jpeg;base64,