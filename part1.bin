<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="color-scheme" content="light dark">
<link rel="icon" href="data:,">
<title>ホロピクセル インタラクティブ版</title>
<style>
  :root{
    --bg:#f4f1ea;
    --bg2:#ece8df;
    --surface:#fffdf8;
    --surface2:#f9f6ef;
    --ink:#171713;
    --muted:#6b675e;
    --line:#ddd6c8;
    --line2:#cbc3b2;
    --accent:#c73e1d;
    --accent2:#0f766e;
    --gold:#b7791f;
    --shadow:0 12px 32px rgba(28,25,18,.10), 0 2px 6px rgba(28,25,18,.06);
    --radius:14px;
    --mono: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    --sans: "Hiragino Kaku Gothic ProN", "Hiragino Sans", "Noto Sans JP", system-ui, -apple-system, sans-serif;
  }
  @media (prefers-color-scheme: dark){
    :root{
      --bg:#111110;
      --bg2:#171716;
      --surface:#1c1c1a;
      --surface2:#232320;
      --ink:#f2efe6;
      --muted:#a8a295;
      --line:#33322e;
      --line2:#44423c;
      --accent:#ff6b4a;
      --accent2:#2dd4bf;
      --shadow:0 12px 32px rgba(0,0,0,.35);
    }
  }
  *{box-sizing:border-box}
  html,body{margin:0;padding:0}
  body{background:var(--bg);color:var(--ink);font-family:var(--sans);line-height:1.6;-webkit-font-smoothing:antialiased}
  a{color:var(--accent2)}
  .wrap{max-width:1180px;margin:0 auto;padding:28px 18px 48px}
  /* header */
  .top{display:flex;flex-wrap:wrap;gap:20px;align-items:flex-end;justify-content:space-between;margin-bottom:18px}
  .top h1{font-size:42px;line-height:.95;letter-spacing:-.03em;margin:0;font-weight:900}
  .top h1 span{color:var(--accent)}
  .top h1 small{display:block;font-size:13px;letter-spacing:.18em;text-transform:uppercase;font-weight:700;color:var(--muted);margin-bottom:10px;letter-spacing:.16em}
  .lead{max-width:560px;font-size:15.5px;color:var(--muted);margin:0;line-height:1.75}
  .lead strong{color:var(--ink)}
  .spec-row{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}
  .chip{font-family:var(--mono);font-size:11.5px;letter-spacing:.02em;border:1px solid var(--line2);background:var(--surface);padding:6px 9px;border-radius:999px;color:var(--ink)}
  .chip b{color:var(--accent)}
  /* lab layout */
  .lab{display:grid;grid-template-columns:1.65fr .95fr;gap:16px;align-items:start}
  @media(max-width:900px){.lab{grid-template-columns:1fr} .top h1{font-size:34px}}
  .card{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow);overflow:hidden}
  /* PART1: plate fixed at top, controls scroll underneath it */
  .viewer-card{overflow:visible}
  .plate-sticky{position:sticky;top:0;z-index:30;background:var(--surface);border-bottom:1px solid var(--line);border-radius:var(--radius) var(--radius) 0 0;box-shadow:0 10px 18px rgba(28,25,18,.10)}
  .plate-sticky .card-head{border-bottom:0;padding-bottom:8px}
  /* keep the fixed plate compact enough that parameters remain reachable below it */
  .stage{max-width:min(100%,calc(56dvh * 4 / 3));margin-left:auto;margin-right:auto}
  .stage.station-mode{max-width:min(440px,calc(52dvh * 9 / 16))}
  .stage.meas-landscape{max-width:min(100%,calc(52dvh * 16 / 9))}
  /* PART2: priority controls */
  .priority{border:1.5px solid var(--accent2);border-radius:12px;padding:12px;background:var(--surface2)}
  .priority h3{margin:0 0 4px;font-size:13px;letter-spacing:.08em}
  .priority .p-row{display:flex;flex-wrap:wrap;gap:8px;margin-top:8px;align-items:center}
  .priority .p-label{font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);font-weight:800;width:100%}
  .btn.big{padding:11px 16px;font-size:14px}
  .face-dist{font-family:var(--mono);font-size:12.5px;margin-top:8px;color:var(--ink)}
  .face-dist b{color:var(--accent2);font-size:15px}
  .card-head{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:13px 16px;border-bottom:1px solid var(--line)}
  .card-head h2{font-size:13px;letter-spacing:.12em;text-transform:uppercase;margin:0;font-weight:800}
  .card-head p{margin:0;font-size:12px;color:var(--muted);font-family:var(--mono)}
  .readout{font-family:var(--mono);font-size:12px;background:var(--surface2);border:1px solid var(--line);padding:6px 9px;border-radius:8px;white-space:nowrap}
  .readout b{color:var(--accent)}
  /* viewer */
  .stage{position:relative;background:#0c0d0e;aspect-ratio:4/3;overflow:hidden;cursor:grab;touch-action:none;user-select:none}
  .stage:active{cursor:grabbing}
  .stage canvas{width:100%;height:100%;display:block}
  /* station scene: portrait frames — stage becomes a centered portrait panel */
  .stage.station-mode{aspect-ratio:9/16;max-width:440px;margin-left:auto;margin-right:auto}
  #stationCanvas{display:none}
  .stage.station-mode #stationCanvas{display:block}
  .stage.station-mode #glCanvas{display:none}
  /* measured landscape scenes (16:9 tiles): stage follows the tile aspect */
  .stage.meas-landscape{aspect-ratio:16/9;max-width:none}
  .stage.meas-landscape #stationCanvas{display:block}
  .stage.meas-landscape #glCanvas{display:none}
  /* fixed-plate sizing (after the mode rules above so it wins) */
  .stage{max-width:min(100%,calc(56dvh * 4 / 3));margin-left:auto;margin-right:auto}
  .stage.station-mode{max-width:min(440px,calc(52dvh * 9 / 16))}
  .stage.meas-landscape{max-width:min(100%,calc(52dvh * 16 / 9))}
  .controls{padding:16px}
  .slider-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px 18px}
  @media(max-width:560px){.slider-grid{grid-template-columns:1fr}}
  .field label{display:flex;justify-content:space-between;font-size:12.5px;font-weight:700;margin-bottom:6px}
  .field label output{font-family:var(--mono);font-weight:600;color:var(--accent)}
  input[type=range]{width:100%;accent-color:var(--accent);height:28px}
  .btn-row{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}
  button, select{font:inherit}
  .btn{border:1px solid var(--line2);background:var(--surface2);color:var(--ink);padding:8px 12px;border-radius:999px;font-size:13px;font-weight:700;cursor:pointer}
  .btn:hover{border-color:var(--ink)}
  .btn.active{background:var(--ink);color:var(--surface);border-color:var(--ink)}
  .btn.accent{background:var(--accent);color:#fff;border-color:var(--accent)}
  .seg{display:flex;background:var(--surface2);border:1px solid var(--line);border-radius:999px;padding:3px;gap:2px;flex-wrap:wrap}
  .seg button{border:0;background:transparent;padding:7px 10px;border-radius:999px;font-size:12.5px;font-weight:700;cursor:pointer;color:var(--muted)}
  .seg button.active{background:var(--ink);color:var(--surface)}
  .control-label{font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);font-weight:800;margin:16px 0 8px}
  .note{font-size:12.5px;color:var(--muted);line-height:1.7;margin:12px 0 0;border-top:1px dashed var(--line);padding-top:12px}
  .note code{font-family:var(--mono);font-size:11.5px;background:var(--surface2);border:1px solid var(--line);padding:1px 5px;border-radius:5px;color:var(--ink)}
  .tilt-status{font-size:12.5px;line-height:1.7;margin:10px 0 0;padding:9px 12px;border:1px solid var(--line);border-radius:10px;background:var(--surface2);color:var(--muted)}
  .tilt-status b{color:var(--ink)}
  .tilt-status.err{border-color:var(--accent);color:var(--accent)}
  .tilt-status.err b{color:var(--accent)}
  /* face preview (picture-in-picture, mirrored for the user) */
  .face-preview{position:absolute;right:12px;bottom:12px;width:132px;border-radius:10px;overflow:hidden;border:2px solid rgba(255,255,255,.85);box-shadow:0 6px 18px rgba(0,0,0,.35);background:#000;z-index:3;line-height:0}
  .face-preview video{width:100%;height:auto;display:block;transform:scaleX(-1)}
  .face-preview-close{position:absolute;top:4px;right:4px;width:24px;height:24px;border-radius:50%;border:0;background:rgba(0,0,0,.65);color:#fff;font-size:15px;line-height:1;cursor:pointer;display:grid;place-items:center;padding:0}
  .face-preview-cap{position:absolute;left:0;right:0;bottom:0;background:rgba(0,0,0,.62);color:#fff;font-size:10px;line-height:1.4;padding:3px 6px;text-align:center;pointer-events:none}
  /* side panels */
  .side{display:grid;gap:16px}
  .panel-body{padding:16px}
  .quilt-wrap{background:#0c0d0e;border-radius:10px;overflow:hidden;border:1px solid #222}
  .quilt-wrap canvas{width:100%;height:auto;display:block;image-rendering:auto}
  .quilt-cap{font-size:12.5px;color:var(--muted);margin:10px 0 0;line-height:1.7}
  .quilt-cap strong{color:var(--ink)}
  /* inspector */
  .pixel-info{display:flex;gap:10px;align-items:center;margin-bottom:12px}
  .pixel-swatch{width:44px;height:44px;border-radius:9px;border:1px solid rgba(0,0,0,.15);flex-shrink:0}
  .pixel-info div{font-size:13px;line-height:1.5}
  .pixel-info code{font-family:var(--mono);font-size:12px}
  .angle-grid{display:grid;grid-template-columns:repeat(9,1fr);gap:3px}
  .angle-grid i{display:block;aspect-ratio:1;border-radius:3px;border:1px solid rgba(0,0,0,.08)}
  .angle-grid i.center{outline:2px solid var(--ink);outline-offset:1px;z-index:1}
  .axis{display:flex;justify-content:space-between;font-family:var(--mono);font-size:10.5px;color:var(--muted);margin-top:7px}
  .legend{display:flex;gap:14px;flex-wrap:wrap;margin-top:12px;font-size:12px;color:var(--muted)}
  .legend span{display:flex;align-items:center;gap:6px}
  .dot{width:10px;height:10px;border-radius:2px;display:inline-block}
  /* spec table */
  .spec-table{width:100%;border-collapse:collapse;font-size:13px}
  .spec-table th,.spec-table td{padding:9px 0;border-bottom:1px solid var(--line);text-align:left;vertical-align:top}
  .spec-table th{color:var(--muted);font-weight:600;width:42%;padding-right:12px}
  .spec-table td{font-family:var(--mono);font-size:12.5px}
  .spec-table tr:last-child th,.spec-table tr:last-child td{border-bottom:0}
  .formula{background:var(--ink);color:var(--surface);border-radius:10px;padding:14px 16px;font-family:var(--mono);font-size:13px;line-height:1.9;overflow:auto;white-space:nowrap}
  .formula .dim{opacity:.55}
  /* explainer */
  .explainer{margin-top:18px;display:grid;grid-template-columns:1.15fr .85fr;gap:16px}
  @media(max-width:900px){.explainer{grid-template-columns:1fr}}
  .explainer .card{padding:22px}
  .explainer h3{margin:0 0 10px;font-size:20px;line-height:1.3;letter-spacing:-.02em}
  .explainer p{color:var(--muted);font-size:14.5px;line-height:1.85;margin:0 0 12px}
  .explainer p strong{color:var(--ink)}
  .steps{list-style:none;margin:14px 0 0;padding:0;display:grid;gap:0}
  .steps li{display:grid;grid-template-columns:36px 1fr;gap:12px;padding:13px 0;border-top:1px solid var(--line)}
  .steps li:first-child{border-top:0;padding-top:4px}
  .num{width:30px;height:30px;border-radius:50%;background:var(--accent);color:#fff;display:grid;place-items:center;font-family:var(--mono);font-size:13px;font-weight:800}
  .steps b{display:block;font-size:14px}
  .steps span{font-size:13px;color:var(--muted);line-height:1.7;display:block}
  .compare{width:100%;border-collapse:collapse;font-size:13px;margin-top:8px}
  .compare th,.compare td{padding:9px 8px;border-bottom:1px solid var(--line);text-align:left;vertical-align:top}
  .compare th{font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
  .compare td:first-child{font-weight:700;white-space:nowrap}
  .footer{margin-top:18px;display:flex;flex-wrap:wrap;gap:10px;justify-content:space-between;color:var(--muted);font-size:12px;font-family:var(--mono)}
  .kbd{font-family:var(--mono);border:1px solid var(--line2);border-bottom-width:2px;background:var(--surface);padding:1px 6px;border-radius:6px;font-size:11px;color:var(--ink)}
</style>
</head>
<body>
<div class="wrap">

  <header class="top">
    <div>
      <h1><small>Holographic Pixel — Light Field Viewer</small>ホロ<span>ピクセル</span></h1>
      <div class="spec-row">
        <span class="chip">空間 <b id="chipRes">360 × 640</b> px相当</span>
        <span class="chip">角度 <b id="chipAngle">33 視点（横のみ）</b> 方向</span>
        <span class="chip">視野 水平 <b>±30°</b> / 垂直 <b>±20°</b></span>
        <span class="chip">補間 <b>動き補正つき視点補間</b>（実測シーン）</span>
      </div>
    </div>
    <p class="lead">普通の画像は <strong>1ピクセル＝1色</strong>。ホロピクセルは <strong>1ピクセル＝方向ごとの色の表</strong>です。下の板をドラッグすると、目の位置に合わせて全ピクセルが読み出す角度を切り替え、奥の空間が視差付きで再構成されます。</p>
  </header>

  <div class="lab">
    <!-- VIEWER -->
    <section class="card viewer-card" aria-label="ホロピクセル ビューワー">
      <div class="plate-sticky">
      <div class="card-head">
        <h2>板 — 再生面（上部に固定）</h2>
        <div class="readout">θ <b id="roTheta">0.0°</b> &nbsp; φ <b id="roPhi">0.0°</b> &nbsp;·&nbsp; <span id="roMode">連続</span></div>
      </div>

      <div class="stage" id="stage">
        <canvas id="glCanvas" width="960" height="720" aria-label="視点をドラッグで変えられるホログラム板"></canvas>
        <canvas id="stationCanvas" width="540" height="960" aria-label="実写動画の視点をドラッグで変えられる板"></canvas>
        <div class="face-preview" id="facePreview" hidden>
          <video id="faceVideo" autoplay playsinline muted></video>
          <button class="face-preview-close" id="facePreviewClose" type="button" aria-label="カメラプレビューを隠す">×</button>
          <span class="face-preview-cap">顔検出中 — 映像は端末内でのみ処理</span>
        </div>
      </div>
      </div><!-- /plate-sticky -->

      <div class="controls">
        <!-- PART2: priority controls, first under the plate -->
        <div class="priority" aria-label="よく使う操作">
          <h3>よく使う操作</h3>
          <div class="p-row">
            <span class="p-label">視点の動かし方</span>
            <button class="btn big accent" id="tiltBtn">傾きで動かす</button>
            <button class="btn big accent" id="faceBtn">顔で動かす</button>
            <button class="btn" id="facePreviewBtn" hidden aria-pressed="true">プレビュー</button>
          </div>
          <div class="p-row">
            <span class="p-label">現在を正面にする（校正）</span>
            <button class="btn big" id="recenterBtn">◎ 現在を正面にする</button>
            <button class="btn" id="tiltCalBtn" hidden>傾き：いまの姿勢を正面にする</button>
            <button class="btn" id="faceCalBtn" hidden>顔：いまの顔位置を正面にする</button>
          </div>
          <div class="p-row">
            <span class="p-label">動作の反転 — 傾き・顔操作</span>
            <button class="btn" id="flipXBtn" aria-pressed="false">⇋ 水平を反転</button>
            <button class="btn" id="flipYBtn" aria-pressed="false">⇅ 垂直を反転</button>
          </div>
          <div class="face-dist" id="faceDistReadout" hidden>推定視距離（窓モデル）：<b id="faceDistVal">— cm</b> ／ 正面の基準距離：<b id="faceDistBase">— cm</b></div>
          <p class="tilt-status" id="tiltStatus" hidden></p>
          <p class="tilt-status" id="faceStatus" hidden></p>
        </div>

        <div class="control-label">シーン — 板に焼かれているデータ</div>
        <div class="seg" id="sceneSeg" role="tablist">
          <button data-scene="station" class="active">駅（実測・横33視点）</button>
          <button data-scene="akasaka">赤坂通り（実測・横33視点）</button>
          <button data-scene="sawadee_wide">サワディー（横）</button>
          <button data-scene="sawadee_portrait">サワディー（縦）</button>
          <button data-scene="photo">実写（深度つき写真）</button>
          <button data-scene="blocks">ブロック</button>
        </div>

        <div id="depthRow" hidden>
          <div class="control-label">距離（奥行き）— サワディー（縦）専用：寄る・引くと被写体を基準に背景がずれる</div>
          <div class="field">
            <label>距離 z（左＝引く／右＝寄る） <output id="outZ">0</output></label>
            <input type="range" id="dollySlider" min="-100" max="100" step="1" value="0">
          </div>
          <div class="control-label">深度ソース — 同じ場面で見比べられます</div>
          <div class="seg" id="depthSeg" role="tablist">
            <button data-depthsrc="est" class="active">深度：推定（単眼）</button>
            <button data-depthsrc="sfm">深度：実測（SfM）</button>
          </div>
          <p class="note" style="border-top:0;padding-top:8px;margin-top:4px" id="depthNote">推定：Depth Anything V2 を33フレームそれぞれに適用し全体で正規化した単眼推定。実測：81フレームを COLMAP SfM で復元（全フレーム登録・10,003点）し、疎な点を各フレームへ投影して拡散で埋めたもの。SfM実測のカメラ軌道は中心フレーム比 θ −24.9°〜+29.8°、距離は約6%変動（13.06→12.32→12.51、シーン単位）。顔モード中は、顔までの推定距離の変化でも z が連動します。</p>
        </div>

        <div class="slider-grid" style="margin-top:16px">
          <div class="field">
            <label>水平視点 θ <output id="outX">0°</output></label>
            <input type="range" id="sliderX" min="-30" max="30" step="0.5" value="0">
          </div>
          <div class="field">
            <label>垂直視点 φ <output id="outY">0°</output></label>
            <input type="range" id="sliderY" min="-20" max="20" step="0.5" value="0">
          </div>
        </div>

        <div class="control-label">プリセット視点</div>
        <div class="btn-row" style="margin-top:0">
          <button class="btn" data-preset="-24,0">◀ 左から</button>
          <button class="btn active" data-preset="0,0">正面</button>
          <button class="btn" data-preset="24,0">右から ▶</button>
          <button class="btn" data-preset="0,14">上から</button>
          <button class="btn" data-preset="-18,-10">左下から</button>
          <button class="btn" id="orbitBtn">◎ 自動で揺らす</button>
        </div>

        <div class="control-label">角度の読み出し方 — 遮蔽の境界で違いが出ます</div>
        <div class="seg" id="modeSeg" role="tablist">
          <button data-mode="cont" class="active">連続（動き補正つき補間）</button>
          <button data-mode="17">最近傍 17×17</button>
          <button data-mode="9">最近傍 9×9</button>
          <button data-mode="5">最近傍 5×5</button>
        </div>

        <div id="interpRow">
          <div class="control-label">フレーム間の補い方 — 実測シーンで「連続」のときに効きます</div>
          <div class="seg" id="interpSeg" role="tablist">
            <button data-interp="warp" class="active">動き補正つき（推奨）</button>
            <button data-interp="fade">クロスフェードのみ</button>
            <button data-interp="none">補間なし</button>
          </div>
          <p class="note" style="border-top:0;padding-top:8px;margin-top:4px">隣り合う実測フレームの間で、画面を領域に分けて各領域の動き（オプティカルフロー）を端末内で推定します。中間の視点では、前のフレームをその分だけ進め、後ろのフレームを戻して重ねるので、ただ重ねるクロスフェードのような二重像にならず、柱や看板が位置を変えながらつながります。 <span id="interpStatus" style="font-family:var(--mono)">動きデータ準備中…</span></p>
        </div>

        <p class="note" id="modeNote">初期値は<strong style="color:var(--ink)">連続</strong>です。全ピクセルが同じ視点で一斉に動き、傾きに滑らかに追従します。最近傍に切り替えると方向を1つ選ぶため縁はパキッとしますが、視点全体が同じタイミングで切り替わるのでブロックごとに順番に変わることはありません。粗い 5×5 ほど切り替わりが階段状に見えます。</p>
      </div>
    </section>

    <!-- SIDE -->
    <aside class="side">
      <section class="card">
        <div class="card-head"><h2>キルト — データ本体</h2><p id="quiltTiles">33 VIEWS · 11 × 3</p></div>
        <div class="panel-body">
          <div class="quilt-wrap"><canvas id="quiltCanvas" width="540" height="540" style="display:none"></canvas><img id="quiltImg" src="data:image/jpeg;base64," alt="駅ホーム実写のキルト — 動画から0.25秒ごとに抜いた33フレームを11×3に並べたもの。中央のタイルが動画の中間フレーム" style="width:100%;height:auto;display:block"></div>
          <p class="quilt-cap" id="quiltCap"><strong>同じデータの別の並び。</strong> 上の板が「ピクセル単位」に並べ替えた姿だとすれば、こちらは「カメラ単位」の並び。各タイルが1つの視点から見た全体像で、81タイルで全方向を記録しています。視点を動かすことは、この中から近いタイルの色をピクセルごとに拾い直すことと等価です。</p>
        </div>
      </section>

      <section class="card">
        <div class="card-head"><h2>1ピクセルを覗く</h2><p id="pixelCoord">P (128, 96)</p></div>
        <div class="panel-body">
          <div class="pixel-info">
            <div class="pixel-swatch" id="pixelSwatch" style="background:#eab308"></div>
            <div>正面から見た色<br><code id="pixelHex">#EAB308</code><span id="pixelNote"> · 奥行きの異なるブロックの手前／奥で色が入れ替わります</span></div>
          </div>
          <div class="angle-grid" id="angleGrid" aria-label="選択ピクセルの方向ごとの色"></div>
          <div class="axis"><span>← θ −30°</span><span>φ ↑</span><span>θ +30° →</span></div>
          <p class="quilt-cap" id="pixelGridCap">この 17×17 が、<strong>1ピクセルが持っているもの</strong>です。板の上でクリック／タップすると、その場所の表に切り替わります。縁のピクセルほど、方向で色が激しく変わります。</p>
          <div class="legend" id="blockLegend">
            <span><i class="dot" style="background:#e63946"></i>手前 z≈0.8</span>
            <span><i class="dot" style="background:#f59e0b"></i>中間 z≈1.4</span>
            <span><i class="dot" style="background:#0f766e"></i>奥 z≈2.0</span>
            <span><i class="dot" style="background:#e7e2d6;border:1px solid #ccc"></i>奥の壁</span>
          </div>
        </div>
      </section>

      <section class="card">
        <div class="card-head"><h2>ファイル仕様 v1</h2><p>.holo</p></div>
        <div class="panel-body">
          <div class="formula">I(x, y, θ, φ) = RGB<br><span class="dim">通常の画像&nbsp; I(x, y) = RGB の拡張</span></div>
          <table class="spec-table" style="margin-top:8px">
            <tr><th>記録対象</th><td id="specTarget">色ブロック 9個（3×3、奥行き 3段階）</td></tr>
            <tr><th>サンプル総数</th><td id="specSamples">256×192×81 ≒ 3,981,312 光線</td></tr>
            <tr><th>生容量の目安</th><td id="specSize">約 11.4 MB（RGB 8bit、無圧縮）</td></tr>
            <tr><th>ゼロ視差面</th><td>板の位置 z = 0</td></tr>
            <tr><th>窓モデル（顔モード）</th><td>iPhone 13 Pro：表示領域 約64.6 × 139.8 mm（2532×1170 px・460 ppi）を窓の実寸とし、両目の間隔 6.4 cm を基準に視距離と画面中心からのずれ（cm）を推定、θ/φ = atan（ずれ／距離）で視点を決める</td></tr>
            <tr><th>深度（縦サワディーのみ）</th><td id="specDepth">推定（単眼 Depth Anything V2・33フレーム全体で正規化）／実測（COLMAP SfM・81フレーム全登録・10,003点、疎点を投影し拡散で補完）の2種を切替可能</td></tr>
            <tr><th>圧縮の考え方</th><td>角度方向は滑らか → フーリエ係数で保持、縁だけ係数を増やす</td></tr>
          </table>
        </div>
      </section>
    </aside>
  </div>

  <div class="explainer">
    <section class="card">
      <h3>記録 → 再生の流れ</h3>
      <p>仮想空間に透明な板を置き、板の各点から多方向へ光線を飛ばして当たった色を保存する——それが記録です。再生はその逆で、<strong>目の位置 E から各ピクセル P へ引いた方向</strong>の色だけを拾い集めると、その目から見た正しい透視像になります。</p>
      <ol class="steps">
        <li><span class="num">1</span><div><b>記録：方向ごとに色を焼く</b><span>ピクセル P(100,200) なら、−20°では奥の赤ブロック、0°では隙間越しの壁、+20°では手前の青ブロック——を別々に保存。</span></div></li>
        <li><span class="num">2</span><div><b>再生：目が方向を決める</b><span>目を左へ動かすと全ピクセルが一斉に隣の角度を読む。手前は大きく、奥は小さくずれるので、隠れていた面が出てきます。</span></div></li>
        <li><span class="num">3</span><div><b>本物のホログラムとの対応</b><span>干渉縞が「角度で波長を選ぶフィルター」なら、ホロピクセルは「角度で色を選ぶ表」。位相を捨てて光線の色だけを残した、ディスプレイで見られる版です。</span></div></li>
      </ol>
    </section>

    <section class="card">
      <h3>試して分かること</h3>
      <p>プリセットの「左から／右から」を切り替えて、中央の黄色ブロックと奥のブロックの重なりを見比べてください。</p>
      <table class="compare">
        <tr><th style="width:28%">見る場所</th><th>視点を動かすと</th></tr>
        <tr><td>ブロックの縁</td><td>奥のブロックが現れたり隠れたりする（遮蔽の変化）</td></tr>
        <tr><td>奥の壁の格子</td><td>ブロックより小さくずれる（奥行きで視差が違う証拠）</td></tr>
        <tr><td>1ピクセル検査</td><td>平らな面の中央は一色、縁は方向で色が割れる</td></tr>
        <tr><td>5×5 モード</td><td>角度が粗く、ドラッグでカクッと段階的に切り替わる</td></tr>
      </table>
      <p style="margin-top:14px">キーボードでも操作できます： <span class="kbd">←</span> <span class="kbd">→</span> <span class="kbd">↑</span> <span class="kbd">↓</span> で視点、<span class="kbd">0</span> で正面に戻ります。</p>
    </section>
  </div>

  <div class="footer">
    <span>HOLOPIXEL VIEWER — LIGHT FIELD, NOT A FLAT IMAGE</span>
    <span>DRAG / SLIDER / ARROW KEYS</span>
  </div>
</div>

<script>
// ---------- Scene definition (shared by WebGL + CPU inspector) ----------
var BOXES = [
  {cx:-1.05, cy: 0.62, cz:0.78, h:0.335, col:[0.902,0.224,0.275], hex:'#E63946', name:'赤'},
  {cx: 0.00, cy: 0.62, cz:1.38, h:0.335, col:[0.961,0.620,0.043], hex:'#F59E0B', name:'橙'},
  {cx: 1.05, cy: 0.62, cz:1.98, h:0.335, col:[0.059,0.463,0.431], hex:'#0F766E', name:'深緑'},
  {cx:-1.05, cy: 0.00, cz:1.38, h:0.335, col:[0.145,0.388,0.922], hex:'#2563EB', name:'青'},
  {cx: 0.00, cy: 0.00, cz:0.82, h:0.36,  col:[0.918,0.702,0.031], hex:'#EAB308', name:'黄'},
  {cx: 1.05, cy: 0.00, cz:1.48, h:0.335, col:[0.925,0.282,0.600], hex:'#EC4899', name:'桃'},
  {cx:-1.05, cy:-0.62, cz:1.98, h:0.335, col:[0.518,0.800,0.086], hex:'#84CC16', name:'黄緑'},
  {cx: 0.00, cy:-0.62, cz:1.48, h:0.335, col:[0.024,0.714,0.831], hex:'#06B6D4', name:'水色'},
  {cx: 1.05, cy:-0.62, cz:0.80, h:0.335, col:[0.976,0.451,0.086], hex:'#F97316', name:'朱'}
];
function rayBox(ox,oy,oz, dx,dy,dz, b){
  var tmin=-1e9, tmax=1e9, axis=-1;
  var o=[ox,oy,oz], d=[dx,dy,dz], c=[b.cx,b.cy,b.cz];
  for(var i=0;i<3;i++){
    var lo=c[i]-b.h, hi=c[i]+b.h;
    if(Math.abs(d[i])<1e-8){ if(o[i]<lo||o[i]>hi) return -1; }
    else{
      var t1=(lo-o[i])/d[i], t2=(hi-o[i])/d[i];
      if(t1>t2){var tmp=t1;t1=t2;t2=tmp;}
      if(t1>tmin){tmin=t1;axis=i;}
      if(t2<tmax)tmax=t2;
      if(tmin>tmax) return -1;
    }
  }
  return tmin>0.001 ? tmin : -1;
}
function traceCPU(px,py, sx,sy){
  // ray from plate point (px,py,0) along direction (sx,sy,1)
  var len=Math.sqrt(sx*sx+sy*sy+1), dx=sx/len, dy=sy/len, dz=1/len;
  var best=1e9, bestCol=null, bestAxis=-1, hit=null;
  for(var i=0;i<BOXES.length;i++){
    var t=rayBox(px,py,0, dx,dy,dz, BOXES[i]);
    if(t>0 && t<best){best=t;bestCol=BOXES[i];hit=BOXES[i];bestAxis=0;}
  }
  if(bestCol){
    // simple shading guess by slope: top-ish brighter
    var shade = 0.92;
    return {hex:bestCol.hex, col:bestCol.col, shade:shade, isWall:false};
  }
  // wall at z=2.62
  var t=(2.62)/dz, wx=px+dx*t, wy=py+dy*t;
  var gx=Math.floor((wx+3)*4), gy=Math.floor((wy+3)*4);
  var checker=((gx+gy)%2===0);
  return {hex: checker?'#E9E4D8':'#DDD6C6', col: checker?[0.91,0.89,0.85]:[0.86,0.83,0.77], isWall:true};
}
function shadeHex(hex, f){
  var n=parseInt(hex.slice(1),16);
  var r=Math.min(255,Math.round(((n>>16)&255)*f)), g=Math.min(255,Math.round(((n>>8)&255)*f)), bl=Math.min(255,Math.round((n&255)*f));
  return 'rgb('+r+','+g+','+bl+')';
}

// ---------- State ----------
var state={ ex:0, ey:0, tx:0, ty:0, z:0, tz:0, depthSrc:'est', mode:'cont', interp:'warp', orbit:false, t:0, selX:128, selY:96, glide:null, scene:'station' };
var modeLabel={cont:'連続', '17':'最近傍 17×17','9':'最近傍 9×9','5':'最近傍 5×5'};

// ---------- WebGL ----------
var VS='attribute vec2 aPos; varying vec2 vUv; void main(){ vUv=aPos*0.5+0.5; gl_Position=vec4(aPos,0.,1.); }';
var FS=[
'precision highp float;',
'varying vec2 vUv; uniform vec2 uEye; uniform float uQuant; uniform float uAspect;',
'vec3 boxCol(int i){',
' if(i==0) return vec3(0.902,0.224,0.275); if(i==1) return vec3(0.961,0.620,0.043); if(i==2) return vec3(0.059,0.463,0.431);',
' if(i==3) return vec3(0.145,0.388,0.922); if(i==4) return vec3(0.918,0.702,0.031); if(i==5) return vec3(0.925,0.282,0.600);',
' if(i==6) return vec3(0.518,0.800,0.086); if(i==7) return vec3(0.024,0.714,0.831); return vec3(0.976,0.451,0.086); }',
'vec3 boxC(int i){',
' if(i==0) return vec3(-1.05,0.62,0.78); if(i==1) return vec3(0.0,0.62,1.38); if(i==2) return vec3(1.05,0.62,1.98);',
' if(i==3) return vec3(-1.05,0.0,1.38); if(i==4) return vec3(0.0,0.0,0.82); if(i==5) return vec3(1.05,0.0,1.48);',
' if(i==6) return vec3(-1.05,-0.62,1.98); if(i==7) return vec3(0.0,-0.62,1.48); return vec3(1.05,-0.62,0.80); }',
'float boxH(int i){ return i==4 ? 0.36 : 0.335; }',
'float hitBox(vec3 o, vec3 d, vec3 c, float h, out vec3 nrm){',
' vec3 lo=c-vec3(h), hi=c+vec3(h); float tmin=-1e9; float tmax=1e9; int ax=-1;',
' for(int k=0;k<3;k++){ float ok = k==0?o.x:(k==1?o.y:o.z); float dk = k==0?d.x:(k==1?d.y:d.z); float lk = k==0?lo.x:(k==1?lo.y:lo.z); float hk = k==0?hi.x:(k==1?hi.y:hi.z);',
'   if(abs(dk)<1e-6){ if(ok<lk||ok>hk) return -1.; } else { float t1=(lk-ok)/dk; float t2=(hk-ok)/dk; if(t1>t2){float tt=t1;t1=t2;t2=tt;} if(t1>tmin){tmin=t1;ax=k;} if(t2<tmax)tmax=t2; if(tmin>tmax) return -1.; } }',
' nrm=vec3(0.); float s = (ax==0?d.x:(ax==1?d.y:d.z))>0. ? -1. : 1.; if(ax==0)nrm.x=s; else if(ax==1)nrm.y=s; else nrm.z=s;',
' return tmin>0.001 ? tmin : -1.; }',
'void main(){',
' vec2 p2 = vec2((vUv.x*2.-1.)*1.62*uAspect/1.333, (vUv.y*2.-1.)*1.22);',
' // Actually map plate: x in [-1.62,1.62], y in [-1.22,1.22] scaled — simplify below',
' vec3 P = vec3((vUv.x*2.-1.)*1.62, (vUv.y*2.-1.)*1.22, 0.);',
' vec3 E = vec3(uEye.x*1.55, uEye.y*1.05, -3.0);',
' // Quantize the EYE position globally (not per-pixel slope). Per-pixel quantization',
' // made each block cross its threshold at a different eye angle, so boxes popped',
' // one after another. Snapping the single shared eye makes the whole plate switch',
' // in the same frame, all at once.',
' if(uQuant>0.5){ float stx=3.10/(uQuant-1.); float sty=2.10/(uQuant-1.); E.x=floor(E.x/stx+0.5)*stx; E.y=floor(E.y/sty+0.5)*sty; }',
' vec3 D = normalize(P-E);',
' vec3 dir = D;',
' vec3 o=P;',
' float best=1e9; vec3 col=vec3(0.); vec3 bn=vec3(0.,0.,-1.); bool hit=false;',
' for(int i=0;i<9;i++){ vec3 n; float t=hitBox(o,dir,boxC(i),boxH(i),n); if(t>0.&&t<best){best=t;col=boxCol(i);bn=n;hit=true;} }',
' if(hit){ vec3 L=normalize(vec3(-0.45,0.75,-0.55)); float dif=max(dot(bn,L),0.); float sh=0.68+0.42*dif; if(bn.y>0.5) sh*=1.06; if(bn.z<-0.5) sh*=1.02; col*=sh;',
'   // edge highlight',
'   vec3 hp=o+dir*best; }',
' else { float t=(2.62)/dir.z; vec3 hp=o+dir*t; float gx=floor((hp.x+3.)*3.2); float gy=floor((hp.y+3.)*3.2); float ch=mod(gx+gy,2.); col=mix(vec3(0.905,0.885,0.845), vec3(0.845,0.815,0.755), ch);',
'   // vignette on wall + soft shadow blobs under blocks approximated by distance',
'   col*=0.96; }',
' // plate glass: moving specular + border darkening',
' float spec=pow(max(0.,1.-abs(vUv.x-0.5-uEye.x*0.18)*1.6)*max(0.,1.-abs(vUv.y-0.62-uEye.y*0.12)*2.2),3.)*0.10;',
' col+=spec;',
' float bord=smoothstep(0.,0.012,vUv.x)*smoothstep(1.,0.988,vUv.x)*smoothstep(0.,0.016,vUv.y)*smoothstep(1.,0.984,vUv.y);',
' col*=mix(0.55,1.,bord);',
' gl_FragColor=vec4(col,1.); }'
].join('\n');

function makeGL(canvas){
  var gl=canvas.getContext('webgl',{antialias:false, preserveDrawingBuffer:true});
  if(!gl) return null;
  function sh(type,src){var s=gl.createShader(type);gl.shaderSource(s,src);gl.compileShader(s);return s;}
  var prog=gl.createProgram();
  gl.attachShader(prog, sh(gl.VERTEX_SHADER,VS));
  gl.attachShader(prog, sh(gl.FRAGMENT_SHADER,FS));
  gl.linkProgram(prog); gl.useProgram(prog);
  var buf=gl.createBuffer(); gl.bindBuffer(gl.ARRAY_BUFFER,buf);
  gl.bufferData(gl.ARRAY_BUFFER,new Float32Array([-1,-1, 1,-1, -1,1, 1,1]),gl.STATIC_DRAW);
  var loc=gl.getAttribLocation(prog,'aPos'); gl.enableVertexAttribArray(loc); gl.vertexAttribPointer(loc,2,gl.FLOAT,false,0,0);
  return {gl:gl, prog:prog, buf:buf, aPos:loc, uEye:gl.getUniformLocation(prog,'uEye'), uQuant:gl.getUniformLocation(prog,'uQuant'), uAspect:gl.getUniformLocation(prog,'uAspect')};
}
var mainGL=makeGL(document.getElementById('glCanvas'));
var quiltGL=makeGL(document.getElementById('quiltCanvas'));

// ---------- Photo scene: quilt texture sampled per holopixel ----------
// Data: data:image/jpeg;base64, — 3264x2448, 17x17 tiles of 192x144.
// Column = horizontal viewpoint (left -> right), row = vertical viewpoint
// (top row = view from above). Each plate pixel reads its own position
// inside the tiles, so parallax/occlusion come from the data itself.
// The quilt was synthesized from ONE real photograph plus a per-pixel depth
// map (Depth Anything V2 estimate): every pixel is warped by its own depth,
// so disparity varies continuously across the whole frame — there are no
// layers and no cutout objects, hence no cardboard-style flatness.
var PHOTO_FS=[
'precision highp float;',
'varying vec2 vUv; uniform sampler2D uTex; uniform vec2 uTile; uniform float uQuant;',
'vec3 sampleTile(float c, float r, vec2 cell){',
' vec2 uv=vec2((c+cell.x)/17., 1.-(r+(1.-cell.y))/17.);',
' return texture2D(uTex, uv).rgb; }',
'void main(){',
' // this plate pixel position inside a tile (texel-center snapped)',
' vec2 cell=vec2((floor(vUv.x*192.)+.5)/192., (floor(vUv.y*144.)+.5)/144.);',
' float fx=clamp(uTile.x,0.,16.); float fy=clamp(uTile.y,0.,16.);',
' vec3 col;',
' if(uQuant>0.5){',
'   // nearest modes: ONE whole-view tile for the entire plate, chosen from',
'   // the single shared (quantized) viewpoint — same unified switching as blocks.',
'   // The photo grid is 17x17: mode 17 is native (step 1), 9 and 5 are coarser',
'   // subsets of the same 17x17 grid (steps 2 and 4).',
'   float st=16./(uQuant-1.);',
'   float qx=floor(fx/st+.5)*st; float qy=floor(fy/st+.5)*st;',
'   col=sampleTile(floor(qx+.5), floor(qy+.5), cell);',
' } else {',
'   // continuous: bilinear blend of the 4 nearest viewpoint tiles, per pixel',
'   float c0=floor(fx); float r0=floor(fy); float wx=fx-c0; float wy=fy-r0;',
'   float c1=min(c0+1.,16.); float r1=min(r0+1.,16.);',
'   vec3 s00=sampleTile(c0,r0,cell); vec3 s10=sampleTile(c1,r0,cell);',
'   vec3 s01=sampleTile(c0,r1,cell); vec3 s11=sampleTile(c1,r1,cell);',
'   col=mix(mix(s00,s10,wx), mix(s01,s11,wx), wy);',
' }',
' float bord=smoothstep(0.,0.012,vUv.x)*smoothstep(1.,0.988,vUv.x)*smoothstep(0.,0.016,vUv.y)*smoothstep(1.,0.984,vUv.y);',
' col*=mix(0.55,1.,bord);',
' gl_FragColor=vec4(col,1.); }'
].join('\n');
var photoGL=null, photoTex=null, photoPixels=null;
function makePhotoGL(){
  var gl=mainGL.gl;
  function sh(type,src){var s=gl.createShader(type);gl.shaderSource(s,src);gl.compileShader(s);return s;}
  var prog=gl.createProgram();
  gl.attachShader(prog, sh(gl.VERTEX_SHADER,VS));
  gl.attachShader(prog, sh(gl.FRAGMENT_SHADER,PHOTO_FS));
  gl.linkProgram(prog);
  var buf=gl.createBuffer(); gl.bindBuffer(gl.ARRAY_BUFFER,buf);
  gl.bufferData(gl.ARRAY_BUFFER,new Float32Array([-1,-1, 1,-1, -1,1, 1,1]),gl.STATIC_DRAW);
  return {prog:prog, buf:buf, aPos:gl.getAttribLocation(prog,'aPos'),
    uTex:gl.getUniformLocation(prog,'uTex'), uTile:gl.getUniformLocation(prog,'uTile'), uQuant:gl.getUniformLocation(prog,'uQuant')};
}
function loadPhotoData(){
  var img=new Image();
  img.onload=function(){
    var gl=mainGL.gl;
    photoTex=gl.createTexture();
    gl.bindTexture(gl.TEXTURE_2D, photoTex);
    gl.pixelStorei(gl.UNPACK_FLIP_Y_WEBGL, true);
    gl.texImage2D(gl.TEXTURE_2D,0,gl.RGB,gl.RGB,gl.UNSIGNED_BYTE,img);
    gl.texParameteri(gl.TEXTURE_2D,gl.TEXTURE_MIN_FILTER,gl.LINEAR);
    gl.texParameteri(gl.TEXTURE_2D,gl.TEXTURE_MAG_FILTER,gl.LINEAR);
    gl.texParameteri(gl.TEXTURE_2D,gl.TEXTURE_WRAP_S,gl.CLAMP_TO_EDGE);
    gl.texParameteri(gl.TEXTURE_2D,gl.TEXTURE_WRAP_T,gl.CLAMP_TO_EDGE);
    var pc=document.createElement('canvas'); pc.width=3264; pc.height=2448;
    var pctx=pc.getContext('2d'); pctx.drawImage(img,0,0);
    try{ photoPixels=pctx.getImageData(0,0,3264,2448).data; }catch(e){ photoPixels=null; }
    if(state.scene==='photo'){ drawMain(); renderInspector(); }
  };
  img.src='data:image/jpeg;base64,';
}
function drawPhoto(){
  var gl=mainGL.gl, c=gl.canvas;
  gl.viewport(0,0,c.width,c.height);
  if(!photoGL||!photoTex){
    gl.clearColor(0.05,0.05,0.06,1); gl.clear(gl.COLOR_BUFFER_BIT);
    return;
  }
  gl.useProgram(photoGL.prog);
  gl.bindBuffer(gl.ARRAY_BUFFER, photoGL.buf);
  gl.enableVertexAttribArray(photoGL.aPos); gl.vertexAttribPointer(photoGL.aPos,2,gl.FLOAT,false,0,0);
  // eye angle -> continuous tile coordinates on the 17x17 grid
  // (col: left..right, row: top..bottom)
  var fx=Math.max(0,Math.min(16,(state.ex+30)/60*16));
  var fy=Math.max(0,Math.min(16,(20-state.ey)/40*16));
  gl.uniform2f(photoGL.uTile, fx, fy);
  gl.uniform1f(photoGL.uQuant, quantValue());
  gl.activeTexture(gl.TEXTURE0);
  gl.bindTexture(gl.TEXTURE_2D, photoTex);
  gl.uniform1i(photoGL.uTex, 0);
  gl.drawArrays(gl.TRIANGLE_STRIP,0,4);
}

// ---------- Measured scenes: 1D light fields from the user's videos ----------
// All measured scenes share one format — assets/quilt_<scene>.jpg, an
// 11x3 grid of tiles: 33 frames extracted every 0.25s. View 16 is each
// video's middle frame and is the CENTER image: the scene starts there,
// at θ = 0°. No estimated depth is used — each frame IS a measured
// viewpoint. The captures moved horizontally only, so θ has data and
// φ does not (φ is left unmapped, honestly). Tile size / quilt size /
// plate aspect are PER SCENE (MEAS_META): 駅・赤坂・サワディー（縦）are
// 360x640 portrait tiles, サワディー（横）is 640x360 landscape tiles.
//   station         : 9.8s station-platform video, t = 0.9s ... 8.9s (center 4.9s)
//   akasaka         : 13.6s video walking along Akasaka-dori past a construction
//                     site, t = 2.78s ... 10.78s (center 6.78s = the video's middle)
//   sawadee_wide    : 16.4s video (1280x720), camera moving straight sideways
//                     past サワディー seated in an office, t = 4.22s ... 12.22s
//                     (center 8.22s). SUBJECT-STABILIZED quilt: his head/upper
//                     body was template-tracked across all 33 frames (face x
//                     403 -> 827 px in the 1280-wide source, y ~250 stable) and
//                     each frame re-cropped with a following 800x450 window, so
//                     he stays at the same position and scale in every tile
//                     while the office background parallaxes behind him.
//   sawadee_portrait: 16.1s video (720x1280), same subject / setup, portrait
//                     framing, t = 4.05s ... 12.05s (center 8.05s)
// The two Sawadee scenes are a gaze test: the subject stays seated while
// the camera moves around him, so as the viewpoint travels, his face
// orientation and gaze relative to the viewer change — the portrait
// "eyes follow you" effect, from real frames only.
// Smoothness: 33 measured views plus, in continuous mode, motion-compensated
// interpolation between the two neighbouring frames (per-region flow,
// estimated on-device — see the flow section below), with a plain crossfade
// kept as a selectable fallback. The same readout modes, presets,
// drag / tilt / face / flip controls as every other scene drive them.
var MEAS_META={
  station:{tw:360,th:640,cols:11,rows:3,qw:3960,qh:1920,src:'data:image/jpeg;base64,